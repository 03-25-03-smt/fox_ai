# Скопируй в .env и заполни. .env НЕ коммитить.

# Токен от @BotFather
BOT_TOKEN=123456:replace-me

# Telegram ID админов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=111111111

# ================================================================
# Железо: Tesla P100 16 ГБ + RTX 3070 8 ГБ + GTX 1050 2 ГБ, Windows.
#   P100     — LLM. Ollama нативно на Windows (настраивается windows\setup-ollama.ps1)
#   RTX 3070 — картинки (/draw), контейнер imagegen
#   GTX 1050 — распознавание речи (Whisper), контейнер speech
# ================================================================

# Номера карт ВНУТРИ Docker (не путать с номерами в Windows!). P100 в Docker не видна,
# поэтому там две карты. Проверить: docker run --rm --gpus all ubuntu nvidia-smi -L
GPU_IMAGEGEN=0    # номер RTX 3070
GPU_SPEECH=1      # номер GTX 1050

# --- Модели (скачиваются на Windows: ollama pull <имя>) ---
# OLLAMA_URL задаётся в docker-compose.yml (Ollama на хосте Windows)
# Основная модель. На P100 можно и qwen2.5:14b — умнее, но ~2 раза медленнее
DEFAULT_MODEL=qwen2.5:7b
# Автовыбор модели под запрос (если пользователь сам не выбрал в /model)
AUTO_MODEL=true
CODE_MODEL=qwen2.5-coder:14b
FAST_MODEL=qwen2.5:3b
# Модель для фото (умеет смотреть на картинки)
VISION_MODEL=qwen2.5vl:7b
# Режим по умолчанию для новых пользователей: chat, code42
DEFAULT_MODE=chat
# Контекст модели в токенах (больше = больше видеопамяти)
NUM_CTX=8192
# Сколько последних сообщений отправлять модели; более старые сворачиваются в резюме
HISTORY_LIMIT=20
SUMMARY_BATCH=10

# --- Память, база знаний, документы ---
# Модель эмбеддингов (ollama pull bge-m3) — хорошо понимает русский
EMBED_MODEL=bge-m3
MEMORY_AUTO=true
# Модель для служебных задач: факты, резюме, перевод (пусто = FAST_MODEL)
MEMORY_MODEL=

# --- Интернет ---
# Секрет для SearXNG — любые 64 hex-символа. В PowerShell:
#   -join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
SEARXNG_SECRET=replace-me

# --- Голос и картинки ---
# Whisper на GTX 1050: int8 — единственный быстрый режим для Pascal, ~1 ГБ VRAM.
# Если голос не работает на 1050 — WHISPER_DEVICE=cpu и WHISPER_MODEL=small
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8
IMAGEGEN_MODEL=stabilityai/sdxl-turbo
# Картинки рисует отдельная карта, выгружать LLM на время /draw не нужно
IMAGEGEN_EXCLUSIVE=false
# Чтобы выключить сервис: оставь пустым и закомментируй его в docker-compose.yml
# SPEECH_URL=
# IMAGEGEN_URL=

# --- 42 intra (https://profile.intra.42.fr/oauth/applications → New application) ---
INTRA_CLIENT_ID=
INTRA_CLIENT_SECRET=
# Во сколько (по TIMEZONE) проверять blackhole и слать напоминания
INTRA_CHECK_HOUR=10

# --- Время ---
TIMEZONE=Europe/Paris

# --- Лимиты ---
# Запросов к моделям в день на человека (0 = без лимита; на админов не действует)
DAILY_LIMIT=0
# Одновременных генераций; столько же поставь в OLLAMA_NUM_PARALLEL (setup-ollama.ps1)
MAX_CONCURRENT=2

# --- Мониторинг и бэкапы ---
# Температура GPU (°C), при которой админам приходит предупреждение
GPU_TEMP_ALERT=85
# Папка для бэкапов базы на Windows (диск 500 ГБ) и сколько хранить
BACKUP_HOST_DIR=B:/fox_ai_backups
BACKUP_KEEP=14
BACKUP_HOUR=4
