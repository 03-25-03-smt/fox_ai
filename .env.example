# Скопируй в .env и заполни. .env НЕ коммитить.

# Токен от @BotFather
BOT_TOKEN=123456:replace-me

# Telegram ID админов через запятую (узнать свой ID: написать боту /start)
ADMIN_IDS=111111111

# ================================================================
# Профиль железа: сейчас ОДНА RTX 3070 (8 ГБ). Значения для P100 + 3070
# указаны в комментариях «P100:» — поменять, когда появится охлаждение.
# ================================================================

# Индексы GPU из `nvidia-smi -L`
# GPU_MAIN — карта для LLM (Ollama), GPU_AUX — для картинок (и речи на GPU)
GPU_MAIN=0      # номер RTX 3070        | P100: номер P100
GPU_AUX=0       # тот же номер RTX 3070 | P100: номер RTX 3070

# --- Модели (должны быть скачаны: docker compose exec ollama ollama pull <имя>) ---
OLLAMA_URL=http://localhost:11434
# Основная модель
DEFAULT_MODEL=qwen2.5:7b
# Автовыбор модели под запрос (если пользователь сам не выбрал в /model)
AUTO_MODEL=true
CODE_MODEL=qwen2.5-coder:7b    # P100: qwen2.5-coder:14b
FAST_MODEL=qwen2.5:3b
# Модель для фото (умеет смотреть на картинки)
VISION_MODEL=qwen2.5vl:7b
# Режим по умолчанию для новых пользователей: chat, code42
DEFAULT_MODE=chat
# Контекст модели в токенах (больше = больше видеопамяти)
NUM_CTX=8192    # если не хватает VRAM — 4096
# Сколько последних сообщений отправлять модели; более старые сворачиваются в резюме
HISTORY_LIMIT=20
SUMMARY_BATCH=10

# --- Память, база знаний, документы ---
# Модель эмбеддингов (ollama pull bge-m3) — хорошо понимает русский
EMBED_MODEL=bge-m3
MEMORY_AUTO=true
# Модель для служебных задач: факты, резюме, перевод (пусто = FAST_MODEL)
MEMORY_MODEL=

# --- Интернет ---
# Секрет для SearXNG: `openssl rand -hex 32`
SEARXNG_SECRET=replace-me

# --- Голос и картинки ---
# Распознавание речи на CPU, чтобы не занимать VRAM
WHISPER_MODEL=small           # P100: large-v3-turbo
WHISPER_DEVICE=cpu            # P100: cuda
WHISPER_COMPUTE=int8          # P100: float16
IMAGEGEN_MODEL=stabilityai/sdxl-turbo
# На время /draw выгружать LLM из видеопамяти, чаты ждут в очереди
IMAGEGEN_EXCLUSIVE=true       # P100: false
# Чтобы выключить сервис: оставь пустым и закомментируй его в docker-compose.yml
# SPEECH_URL=
# IMAGEGEN_URL=

# --- 42 intra (https://profile.intra.42.fr/oauth/applications → New application) ---
INTRA_CLIENT_ID=
INTRA_CLIENT_SECRET=
# Во сколько (по TIMEZONE) проверять blackhole и слать напоминания
INTRA_CHECK_HOUR=10

# --- Время ---
TIMEZONE=Europe/Paris

# --- Лимиты ---
# Запросов к моделям в день на человека (0 = без лимита; на админов не действует)
DAILY_LIMIT=0
# Одновременных генераций, остальные ждут в очереди
MAX_CONCURRENT=1              # P100: 2
# Сколько моделей Ollama держит в VRAM одновременно и сколько запросов параллельно
OLLAMA_MAX_LOADED_MODELS=2    # P100: 3
OLLAMA_NUM_PARALLEL=1         # P100: 2

# --- Мониторинг и бэкапы ---
# Температура GPU (°C), при которой админам приходит предупреждение
GPU_TEMP_ALERT=85
# Папка для бэкапов на хосте (например, на HDD) и сколько хранить
BACKUP_HOST_DIR=/mnt/hdd/fox_ai_backups
BACKUP_KEEP=14
BACKUP_HOUR=4

# --- Хранилище ---
# Папка для моделей Ollama на хосте (сейчас HDD, потом NVMe)
OLLAMA_MODELS_DIR=/mnt/hdd/ollama
