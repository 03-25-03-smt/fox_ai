# Скопируй в .env и заполни. .env НЕ коммитить.

# Токен от @BotFather
BOT_TOKEN=123456:replace-me

# Telegram ID админов через запятую (узнать свой ID: написать боту /start)
ADMIN_IDS=111111111

# --- Модели ---
# Адрес Ollama. В docker compose переопределяется на http://ollama:11434
OLLAMA_URL=http://localhost:11434
# Модель по умолчанию (должна быть скачана: ollama pull <имя>)
DEFAULT_MODEL=qwen2.5:7b
# Режим по умолчанию для новых пользователей: chat или code42
DEFAULT_MODE=chat
# Контекст модели в токенах (больше = больше видеопамяти)
NUM_CTX=8192
# Сколько последних сообщений диалога отправлять модели
HISTORY_LIMIT=20

# --- Память и база знаний ---
# Модель эмбеддингов (ollama pull bge-m3) — хорошо понимает русский
EMBED_MODEL=bge-m3
# Автоматически запоминать факты о пользователе из сообщений
MEMORY_AUTO=true
# Модель для извлечения фактов (пусто = модель пользователя). Лучше маленькая и быстрая.
MEMORY_MODEL=

# --- Интернет ---
# Секрет для SearXNG: сгенерируй `openssl rand -hex 32`
SEARXNG_SECRET=replace-me
# Адрес SearXNG. В docker compose задаётся автоматически; пусто = интернет выключен
SEARXNG_URL=

# --- Хранилище ---
DB_PATH=data/fox_ai.sqlite3
KNOWLEDGE_DIR=knowledge
# Папка для моделей Ollama на хосте (сейчас HDD, потом NVMe)
OLLAMA_MODELS_DIR=/mnt/hdd/ollama
